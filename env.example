# ============================================================
# Loan Pre-Screening Portal — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically by loan_portal.py
# ============================================================

# ----------------------------------------------------------
# REQUIRED: Your Microsoft Foundry Project Endpoint (AZURE_MS_FOUNDRY_ENDPOINT)
# ----------------------------------------------------------
# Where to find it:
#   1. Go to https://ai.azure.com (Microsoft Foundry Portal)
#   2. Select your Project
#   3. Go to Overview → copy the "API endpoint" or "Project endpoint"
# Format: https://<your-hub>.services.ai.azure.com/api/projects/<your-project>
# ----------------------------------------------------------
AZURE_MS_FOUNDRY_ENDPOINT=https://YOUR-HUB.services.ai.azure.com/api/projects/YOUR-PROJECT

# ----------------------------------------------------------
# Port for the Flask web server (default: 5001)
# ----------------------------------------------------------
PORT=5001

# ----------------------------------------------------------
# OPTIONAL: Azure Document Intelligence (for scanned PDFs)
# Only needed if you enable the Document Intelligence extension
# ----------------------------------------------------------
# DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DI-RESOURCE.cognitiveservices.azure.com/
# DOCUMENT_INTELLIGENCE_KEY=your-key-here
